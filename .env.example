# FRITZ!Box
FRITZ_HOST=fritz.box
# Leer lassen: dann wird der zuletzt genutzte Benutzer aus login_sid.lua genommen
FRITZ_USER=
FRITZ_PASSWORD=

# DNS-Adressen der Box für die Gegenprobe (leer: FRITZ_HOST wird aufgelöst)
BOX_DNS_V4=
# z. B. die ULA der Box (fd00::…); leer: keine IPv6-Gegenprobe
BOX_DNS_V6=
# Referenz-Resolver für die CNAME-Kette
REFERENCE_DNS=1.1.1.1

# Weboberfläche. Ohne UI_PASSWORD lauscht sie nur auf 127.0.0.1.
PORT=8053
UI_PASSWORD=

# Ablage für Listen-Cache und Statistik (SQLite)
DATA_DIR=./data
# Statistik-Abfrage in Sekunden, Listen-Aktualisierung in Stunden
STATS_INTERVAL=300
LISTS_REFRESH_HOURS=24
