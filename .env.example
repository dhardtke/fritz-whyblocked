# FRITZ!Box
FRITZ_HOST=fritz.box
# Leave empty to use the most recently used user reported by login_sid.lua
FRITZ_USER=
FRITZ_PASSWORD=

# DNS addresses of the box used for probing (empty: FRITZ_HOST is resolved)
BOX_DNS_V4=
# e.g. the box's ULA (fd00::…); empty: no IPv6 probe
BOX_DNS_V6=
# Reference resolver for the CNAME chain
REFERENCE_DNS=1.1.1.1

# Web UI. Without UI_PASSWORD it only listens on 127.0.0.1.
PORT=8053
UI_PASSWORD=

# Storage for the list cache and statistics (SQLite)
DATA_DIR=./data
# Statistics polling in seconds, list refresh in hours
STATS_INTERVAL=300
LISTS_REFRESH_HOURS=24
