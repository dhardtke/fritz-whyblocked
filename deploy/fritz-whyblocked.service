[Unit]
Description=fritz-whyblocked – why does the FRITZ!Box DNS filter block a domain?
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/app
# FRITZ_PASSWORD and UI_PASSWORD among the rest. No "-" prefix on purpose: without the file the service must not
# start, rather than come up without a password.
EnvironmentFile=%h/app/fritz-whyblocked.env
# current/ is the release fritz-whyblocked-deploy switched to; each release brings the Bun that built it.
ExecStart=%h/app/current/bun run %h/app/current/fritz-whyblocked.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
