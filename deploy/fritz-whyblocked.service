[Unit]
Description=fritz-whyblocked – why does the FRITZ!Box DNS filter block a domain?
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whyblocked
Group=whyblocked
WorkingDirectory=/opt/fritz-whyblocked
EnvironmentFile=/etc/fritz-whyblocked/config.env
LoadCredential=fritz-password:/etc/fritz-whyblocked/fritz-password
LoadCredential=ui-password:/etc/fritz-whyblocked/ui-password
# current/ is the release fritz-whyblocked-deploy switched to; each release brings the Bun that built it.
ExecStart=/opt/fritz-whyblocked/current/bun run /opt/fritz-whyblocked/current/fritz-whyblocked.js
Restart=always
RestartSec=5

StateDirectory=fritz-whyblocked
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
